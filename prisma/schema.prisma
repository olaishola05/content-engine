generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  
  // Custom roles
  role          String    @default("subscriber") // "admin" | "tester" | "subscriber"
  
  brandProfile  BrandProfile?
  generations   Generation[]
  
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model BrandProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  profileType       String   @default("BASIC") // "BASIC" or "FULL"
  
  // Storage for uploaded documents (Cloudflare R2 URLs)
  documentUrls      String[]
  
  // Extracted/Generated Fields
  brandName         String?
  tagline           String?
  niche             String?
  audience          String?
  toneOfVoice       String?
  contentPillars    String[]
  keyPhrases        String[]
  avoidPhrases      String[]
  platformHandles   Json?    // e.g. { linkedin: "url", twitter: "url" }
  ctaStyle          String?
  brandValues       String[]
  uniquePositioning String?
  primaryColor      String?
  font              String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("brand_profile")
}

model Generation {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputText     String
  inputType     String             // 'LINKEDIN_POST' | 'YOUTUBE_TRANSCRIPT' | 'BLOG_ARTICLE' | 'TOPIC_IDEA' | 'DOCUMENT_UPLOAD'
  direction     String             // 'SHORT' | 'LONG' | 'BOTH'
  platforms     String[]           // e.g. ['X', 'INSTAGRAM']
  tone          String             // 'educational' | 'storytelling' | 'promotional' | 'vulnerable' | 'direct'
  createdAt     DateTime           @default(now())
  outputs       GenerationOutput[]

  @@map("generation")
}

model GenerationOutput {
  id                   String     @id @default(cuid())
  generationId         String
  generation           Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  platform             String     // 'X' | 'INSTAGRAM' | 'TIKTOK' | 'YOUTUBE' | 'LINKEDIN'
  recommendedIndex     Int        // 0, 1, or 2 (which variation is recommended)
  recommendationReason String
  variations           Json       // Array of 3 variations: { angle: string, content: string, hookStrength: string, altHooks: string[] }
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@map("generation_output")
}
